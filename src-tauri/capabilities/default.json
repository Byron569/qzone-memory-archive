{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://h5.qzone.qq.com/*" },
        { "url": "https://q1.qlogo.cn/*" },
        { "url": "https://qlogo2.store.qq.com/*" },
        { "url": "https://photovideo.photo.qq.com/*" },
        { "url": "https://*.photo.store.qq.com/*" },
        { "url": "https://*.qpic.cn/*" }
      ]
    }
  ]
}
